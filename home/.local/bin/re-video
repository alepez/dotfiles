#!/usr/bin/env python3

"""Encode videos to mp4 using named ffmpeg profiles."""

import argparse
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


PROFILES = {
    "whatsapp": {
        "description": "Baseline H.264 mp4 for WhatsApp sharing",
        "default_size": "x720",
        "h264_ffmpeg_args": [
            "-profile:v",
            "baseline",
        ],
        "ffmpeg_args": [
            "-pix_fmt",
            "yuv420p",
            "-movflags",
            "+faststart",
        ],
        "encoder_ffmpeg_args": {
            "libx264": [
                "-level",
                "3.0",
            ],
        },
    },
}

QUALITY_LEVELS = {
    "low": {
        "libx264": ["-preset", "veryfast", "-crf", "28"],
        "h264_nvenc": ["-preset", "p3", "-rc:v", "vbr", "-cq:v", "32", "-b:v", "0"],
        "h264_qsv": ["-preset", "fast", "-global_quality", "30"],
    },
    "medium": {
        "libx264": ["-preset", "medium", "-crf", "23"],
        "h264_nvenc": ["-preset", "p4", "-rc:v", "vbr", "-cq:v", "28", "-b:v", "0"],
        "h264_qsv": ["-preset", "medium", "-global_quality", "23"],
    },
    "high": {
        "libx264": ["-preset", "slow", "-crf", "20"],
        "h264_nvenc": ["-preset", "p6", "-rc:v", "vbr", "-cq:v", "22", "-b:v", "0"],
        "h264_qsv": ["-preset", "slow", "-global_quality", "20"],
    },
}

SLOW_PROBE_PRESETS = {
    "libx264": ["-preset", "veryfast"],
    "h264_nvenc": ["-preset", "p1"],
    "h264_qsv": ["-preset", "veryfast"],
}

SLOW_FINAL_PRESETS = {
    "libx264": ["-preset", "veryslow"],
    "h264_nvenc": ["-preset", "p7", "-multipass", "fullres"],
    "h264_qsv": ["-preset", "veryslow"],
}

TWO_PASS_SLOW_ENCODERS = frozenset({"libx264", "h264_nvenc"})


def parse_size(value):
    match = re.fullmatch(r"(?:(\d+)?)x(?:(\d+)?)", value)
    if not match:
        raise argparse.ArgumentTypeError(
            "size must look like WIDTHxHEIGHT, WIDTHx, or xHEIGHT"
        )

    width = int(match.group(1)) if match.group(1) else None
    height = int(match.group(2)) if match.group(2) else None

    if width is None and height is None:
        raise argparse.ArgumentTypeError("size must include width and/or height")

    if width == 0 or height == 0:
        raise argparse.ArgumentTypeError("size values must be greater than zero")

    return (width, height)


def build_scale_filter(size):
    if size is None:
        return None

    width, height = size

    if width and height:
        return (
            f"scale={width}:{height}:force_original_aspect_ratio=decrease:"
            "force_divisible_by=2"
        )

    if width:
        return f"scale={width}:-2"

    return f"scale=-2:{height}"


def default_output_path(src):
    return src.with_suffix(".mp4")


def unique_output_path(path):
    if not path.exists():
        return path

    while True:
        suffix = secrets.token_hex(4)[:7]
        candidate = path.with_name(f"{path.stem}_{suffix}{path.suffix}")
        if not candidate.exists():
            return candidate


def ffmpeg_encoders():
    try:
        result = subprocess.run(
            ["ffmpeg", "-hide_banner", "-encoders"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return ""

    return result.stdout


def probe_duration_seconds(path):
    try:
        result = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-show_entries",
                "format=duration",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(path),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None

    try:
        duration = float(result.stdout.strip())
    except ValueError:
        return None

    return duration if duration > 0 else None


def probe_stream_bitrate(path, stream_selector):
    try:
        result = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-select_streams",
                stream_selector,
                "-show_entries",
                "stream=bit_rate",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(path),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None

    value = result.stdout.strip()
    if not value or value == "N/A":
        return None

    try:
        bitrate = int(value)
    except ValueError:
        return None

    return bitrate if bitrate > 0 else None


def probe_video_bitrate(path):
    bitrate = probe_stream_bitrate(path, "v:0")
    if bitrate is not None:
        return bitrate

    duration = probe_duration_seconds(path)
    if duration is None:
        return None

    total_bitrate = int(path.stat().st_size * 8 / duration)
    audio_bitrate = probe_stream_bitrate(path, "a:0") or 128_000
    video_bitrate = total_bitrate - audio_bitrate

    return max(video_bitrate, 100_000)


def quality_rate_args(encoder, quality):
    args = QUALITY_LEVELS[quality].get(encoder, [])
    filtered = []
    skip_next = False

    for arg in args:
        if skip_next:
            skip_next = False
            continue
        if arg == "-preset":
            skip_next = True
            continue
        filtered.append(arg)

    return filtered


def nvidia_encoder_available(encoders):
    if "h264_nvenc" not in encoders:
        return False

    if shutil.which("nvidia-smi") is None:
        return False

    try:
        subprocess.run(
            ["nvidia-smi"],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return False

    return True


def intel_encoder_available(encoders):
    if "h264_qsv" not in encoders:
        return False

    for vendor_path in Path("/sys/class/drm").glob("renderD*/device/vendor"):
        try:
            vendor = vendor_path.read_text().strip().lower()
        except OSError:
            continue

        if vendor != "0x8086":
            continue

        render_node = Path("/dev/dri") / vendor_path.parents[1].name
        if render_node.exists():
            return True

    return False


def detect_video_encoder():
    encoders = ffmpeg_encoders()

    if nvidia_encoder_available(encoders):
        return ("h264_nvenc", "NVIDIA NVENC")

    if intel_encoder_available(encoders):
        return ("h264_qsv", "Intel Quick Sync")

    return ("libx264", None)


def print_progress_bar(progress):
    width = 40
    filled = min(width, max(0, round(progress * width)))
    bar = "#" * filled + "-" * (width - filled)
    percent = min(100, max(0, round(progress * 100)))
    print(f"\r[{bar}] {percent:3d}%", end="", flush=True)


def run_ffmpeg(command, src):
    duration = probe_duration_seconds(src)
    ffmpeg_command = [
        command[0],
        "-hide_banner",
        "-loglevel",
        "error",
        "-nostats",
        "-progress",
        "pipe:1",
        *command[1:],
    ]

    try:
        process = subprocess.Popen(
            ffmpeg_command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except FileNotFoundError:
        print("ffmpeg is not installed")
        return 1

    last_progress = None
    progress_value = 0.0

    assert process.stdout is not None
    for line in process.stdout:
        key, _, value = line.strip().partition("=")

        if key == "out_time_ms" and duration:
            try:
                progress_value = min(float(value) / 1_000_000 / duration, 1.0)
            except ValueError:
                continue

            rounded_progress = round(progress_value, 3)
            if rounded_progress != last_progress:
                print_progress_bar(progress_value)
                last_progress = rounded_progress
        elif key == "progress" and value == "end":
            print_progress_bar(1.0)

    stderr_output = ""
    if process.stderr is not None:
        stderr_output = process.stderr.read().strip()

    return_code = process.wait()
    if last_progress is not None:
        print()

    if return_code != 0 and stderr_output:
        print(stderr_output, file=sys.stderr)

    return return_code


def parse_args():
    parser = argparse.ArgumentParser(
        description="Encode videos to mp4 using named ffmpeg profiles."
    )
    parser.add_argument("src", help="Source video file")
    parser.add_argument(
        "--profile",
        choices=sorted(PROFILES),
        default="whatsapp",
        help="Encoding profile to use",
    )
    parser.add_argument(
        "--size",
        type=parse_size,
        help="Resize output using WIDTHxHEIGHT, WIDTHx, or xHEIGHT",
    )
    parser.add_argument(
        "--quality",
        choices=["low", "medium", "high"],
        default="medium",
        help="Output quality level",
    )
    parser.add_argument(
        "--slow",
        action="store_true",
        help=(
            "Spend more time encoding for better quality at a similar file size "
            "(fast probe pass, then two-pass VBR at the measured bitrate)"
        ),
    )
    return parser.parse_args()


def encoding_context(profile_name, size):
    profile = PROFILES[profile_name]
    encoder, acceleration_name = detect_video_encoder()
    scale_filter = build_scale_filter(size)
    return profile, encoder, acceleration_name, scale_filter


def build_base_command(src, scale_filter):
    command = ["ffmpeg", "-i", str(src)]

    if scale_filter:
        command.extend(["-vf", scale_filter])

    return command


def append_video_encode_args(command, profile, encoder, quality_args, dst=None):
    command.extend(["-c:v", encoder])
    command.extend(profile.get("h264_ffmpeg_args", []))
    command.extend(profile.get("encoder_ffmpeg_args", {}).get(encoder, []))
    command.extend(quality_args)
    command.extend(profile["ffmpeg_args"])

    if dst is not None:
        command.append(str(dst))

    return command


def build_command(src, dst, profile_name, size, quality):
    profile, encoder, acceleration_name, scale_filter = encoding_context(
        profile_name, size
    )
    command = build_base_command(src, scale_filter)
    append_video_encode_args(
        command,
        profile,
        encoder,
        QUALITY_LEVELS[quality].get(encoder, []),
        dst,
    )

    return command, acceleration_name


def cleanup_passlog_files(logfile):
    for path in logfile.parent.glob(f"{logfile.name}*"):
        path.unlink(missing_ok=True)


def run_slow_encode(src, dst, profile, encoder, scale_filter, quality):
    if encoder not in TWO_PASS_SLOW_ENCODERS:
        command = build_base_command(src, scale_filter)
        quality_args = SLOW_FINAL_PRESETS[encoder] + quality_rate_args(
            encoder, quality
        )
        append_video_encode_args(command, profile, encoder, quality_args, dst)
        print("Slow mode: using slower preset (two-pass unavailable on QSV)")
        return run_ffmpeg(command, src)

    temp_file = tempfile.NamedTemporaryFile(
        suffix=".mp4", delete=False, dir=src.parent
    )
    temp_path = Path(temp_file.name)
    temp_file.close()

    probe_command = build_base_command(src, scale_filter)
    probe_args = SLOW_PROBE_PRESETS[encoder] + quality_rate_args(encoder, quality)
    append_video_encode_args(probe_command, profile, encoder, probe_args, temp_path)

    total_passes = 3 if encoder == "libx264" else 2
    print(f"Pass 1/{total_passes}: measuring bitrate budget...")
    return_code = run_ffmpeg(probe_command, src)
    if return_code != 0:
        temp_path.unlink(missing_ok=True)
        return return_code

    video_bitrate = probe_video_bitrate(temp_path)
    temp_path.unlink(missing_ok=True)
    if video_bitrate is None:
        print("Could not measure video bitrate from probe pass", file=sys.stderr)
        return 1

    bitrate_k = max(video_bitrate // 1000, 100)
    print(f"Target video bitrate: {bitrate_k}k")

    if encoder == "libx264":
        logfile = src.parent / f"re-video-{secrets.token_hex(8)}"
        try:
            pass1_command = build_base_command(src, scale_filter)
            pass1_args = SLOW_FINAL_PRESETS[encoder] + [
                "-b:v",
                f"{bitrate_k}k",
                "-an",
                "-pass",
                "1",
                "-passlogfile",
                str(logfile),
            ]
            append_video_encode_args(pass1_command, profile, encoder, pass1_args)
            pass1_command.extend(["-f", "null", "-"])

            print("Pass 2/3: analysis pass...")
            return_code = run_ffmpeg(pass1_command, src)
            if return_code != 0:
                return return_code

            pass2_command = build_base_command(src, scale_filter)
            pass2_args = SLOW_FINAL_PRESETS[encoder] + [
                "-b:v",
                f"{bitrate_k}k",
                "-pass",
                "2",
                "-passlogfile",
                str(logfile),
            ]
            append_video_encode_args(
                pass2_command, profile, encoder, pass2_args, dst
            )

            print("Pass 3/3: final encode...")
            return run_ffmpeg(pass2_command, src)
        finally:
            cleanup_passlog_files(logfile)

    pass2_command = build_base_command(src, scale_filter)
    pass2_args = SLOW_FINAL_PRESETS[encoder] + [
        "-rc:v",
        "vbr",
        "-b:v",
        f"{bitrate_k}k",
        "-maxrate",
        f"{bitrate_k}k",
    ]
    append_video_encode_args(pass2_command, profile, encoder, pass2_args, dst)

    print("Pass 2/2: final encode (multipass)...")
    return run_ffmpeg(pass2_command, src)


def main():
    args = parse_args()
    src = Path(args.src)

    if not src.is_file():
        print("Source file does not exist")
        return 1

    size = args.size
    if size is None and PROFILES[args.profile]["default_size"]:
        size = parse_size(PROFILES[args.profile]["default_size"])

    dst = unique_output_path(default_output_path(src))

    print(f"Encoding to {dst}")
    print(f"Quality: {args.quality}")
    if args.slow:
        print("Slow mode: enabled")

    if args.slow:
        profile, encoder, acceleration_name, scale_filter = encoding_context(
            args.profile, size
        )
        if acceleration_name:
            print(f"Using {acceleration_name} acceleration")
        return_code = run_slow_encode(
            src, dst, profile, encoder, scale_filter, args.quality
        )
    else:
        command, acceleration_name = build_command(
            src, dst, args.profile, size, args.quality
        )
        if acceleration_name:
            print(f"Using {acceleration_name} acceleration")
        return_code = run_ffmpeg(command, src)

    if return_code == 0:
        print(f"Output: {dst}")

    return return_code


if __name__ == "__main__":
    raise SystemExit(main())
