#!/usr/bin/env python3

import argparse
import os
import shutil
from datetime import datetime


def move_to_date_dir(files, dst_root=".", dry_run=False):
    for file_path in files:
        if not os.path.isfile(file_path):
            print(f"Skipping {file_path}: not a valid file.")
            continue

        # mtime survives SD/import copies; ctime on Linux is inode change time
        # and is often identical for a whole batch.
        file_time = os.path.getmtime(file_path)
        file_date = datetime.fromtimestamp(file_time)

        year = file_date.strftime('%Y')
        year_month = file_date.strftime('%Y-%m')
        year_month_day = file_date.strftime('%Y-%m-%d')

        target_dir = os.path.join(dst_root, year, year_month, year_month_day)
        file_name = os.path.basename(file_path)
        target_path = os.path.join(target_dir, file_name)

        if dry_run:
            print(f"Would move {file_path} to {target_path}")
            continue

        os.makedirs(target_dir, exist_ok=True)
        shutil.move(file_path, target_path)
        print(f"Moved {file_path} to {target_path}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Move files into YYYY/YYYY-MM/YYYY-MM-DD based on mtime."
    )
    parser.add_argument(
        "--dst-root",
        default=".",
        help="Root directory for the date tree (default: current directory)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be done without moving files",
    )
    parser.add_argument("files", nargs="+", help="Files to move")
    args = parser.parse_args()
    move_to_date_dir(args.files, dst_root=args.dst_root, dry_run=args.dry_run)
