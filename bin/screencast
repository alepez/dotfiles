#!/usr/bin/env bash

## Starts a screencast

timestamp() {
  date +%Y-%m-%dT%H-%M-%S --utc | tr -d \\n
}

filename() {
  local date="$( date +%Y/%Y-%m/%Y-%m-%d/%Y%m%dT%H%M%S --utc | tr -d \\n )"
  local p="${HOME}/tmp/${date}"
  if [ -n "${1}" ]; then
    p="${p}-${1}"
  fi
  mkdir -p "${p}"
  echo "${p}/screencast-$( timestamp ).mp4"
}

main() {
  local f="$( filename )"
  local d="$( dirname "${f}" )"
  wf-recorder -g "$( slurp )" -f "${f}"
  echo "file: \"$f\""
  echo "dir: \"$d\""
  thunar "$d" &>/dev/null </dev/null &
}

main
