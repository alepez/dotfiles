#!/usr/bin/env python3

"""Encode videos to mp4 using named ffmpeg profiles."""

import argparse
import re
import secrets
import shutil
import subprocess
import sys
import time
from pathlib import Path


# WhatsApp video share limit; keep a small muxing margin below it.
WHATSAPP_MAX_BYTES = 180 * 1024 * 1024
DEFAULT_AUDIO_BITRATE = 128_000
SIZE_BUDGET_MARGIN = 0.95

PROFILES = {
    "whatsapp": {
        "description": "Baseline H.264 mp4 for WhatsApp sharing (max 180 MiB)",
        "default_size": "x720",
        "max_bytes": WHATSAPP_MAX_BYTES,
        "h264_ffmpeg_args": [
            "-profile:v",
            "baseline",
        ],
        "ffmpeg_args": [
            "-pix_fmt",
            "yuv420p",
            "-movflags",
            "+faststart",
        ],
        "encoder_ffmpeg_args": {
            "libx264": [
                "-level",
                "3.0",
            ],
        },
    },
    "simple": {
        "description": "Compatible H.264 mp4 (single-pass CRF, no size limit)",
        "default_size": None,
        "max_bytes": None,
        "two_pass": False,
        "h264_ffmpeg_args": [
            "-profile:v",
            "baseline",
        ],
        "ffmpeg_args": [
            "-pix_fmt",
            "yuv420p",
            "-movflags",
            "+faststart",
        ],
    },
}

QUALITY_LEVELS = {
    "low": {
        "libx264": ["-preset", "veryfast", "-crf", "28"],
        "h264_nvenc": ["-preset", "p3", "-rc:v", "vbr", "-cq:v", "32", "-b:v", "0"],
        "h264_qsv": ["-preset", "fast", "-global_quality", "30"],
    },
    "medium": {
        "libx264": ["-preset", "medium", "-crf", "23"],
        "h264_nvenc": ["-preset", "p4", "-rc:v", "vbr", "-cq:v", "28", "-b:v", "0"],
        "h264_qsv": ["-preset", "medium", "-global_quality", "23"],
    },
    "high": {
        "libx264": ["-preset", "slow", "-crf", "20"],
        "h264_nvenc": ["-preset", "p6", "-rc:v", "vbr", "-cq:v", "22", "-b:v", "0"],
        "h264_qsv": ["-preset", "slow", "-global_quality", "20"],
    },
}

SLOW_PROBE_PRESETS = {
    "libx264": ["-preset", "veryfast"],
    "h264_nvenc": ["-preset", "p1"],
    "h264_qsv": ["-preset", "veryfast"],
}

SLOW_FINAL_PRESETS = {
    "libx264": ["-preset", "veryslow"],
    "h264_nvenc": ["-preset", "p7", "-multipass", "fullres"],
    "h264_qsv": ["-preset", "veryslow"],
}

TWO_PASS_SLOW_ENCODERS = frozenset({"libx264", "h264_nvenc"})


def parse_size(value):
    match = re.fullmatch(r"(?:(\d+)?)x(?:(\d+)?)", value)
    if not match:
        raise argparse.ArgumentTypeError(
            "size must look like WIDTHxHEIGHT, WIDTHx, or xHEIGHT"
        )

    width = int(match.group(1)) if match.group(1) else None
    height = int(match.group(2)) if match.group(2) else None

    if width is None and height is None:
        raise argparse.ArgumentTypeError("size must include width and/or height")

    if width == 0 or height == 0:
        raise argparse.ArgumentTypeError("size values must be greater than zero")

    return (width, height)


def build_scale_filter(size):
    if size is None:
        return None

    width, height = size

    if width and height:
        return (
            f"scale={width}:{height}:force_original_aspect_ratio=decrease:"
            "force_divisible_by=2"
        )

    if width:
        return f"scale={width}:-2"

    return f"scale=-2:{height}"


def default_output_path(src):
    return src.with_suffix(".mp4")


def unique_output_path(path):
    if not path.exists():
        return path

    while True:
        suffix = secrets.token_hex(4)[:7]
        candidate = path.with_name(f"{path.stem}_{suffix}{path.suffix}")
        if not candidate.exists():
            return candidate


def unique_temp_path(directory, suffix):
    while True:
        candidate = directory / f".re-video-{secrets.token_hex(8)}{suffix}"
        if not candidate.exists():
            return candidate


def ffmpeg_encoders():
    try:
        result = subprocess.run(
            ["ffmpeg", "-hide_banner", "-encoders"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return ""

    return result.stdout


def probe_duration_seconds(path):
    try:
        result = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-show_entries",
                "format=duration",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(path),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None

    try:
        duration = float(result.stdout.strip())
    except ValueError:
        return None

    return duration if duration > 0 else None


def probe_stream_bitrate(path, stream_selector):
    try:
        result = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-select_streams",
                stream_selector,
                "-show_entries",
                "stream=bit_rate",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(path),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None

    value = result.stdout.strip()
    if not value or value == "N/A":
        return None

    try:
        bitrate = int(value)
    except ValueError:
        return None

    return bitrate if bitrate > 0 else None


def probe_video_bitrate(path):
    bitrate = probe_stream_bitrate(path, "v:0")
    if bitrate is not None:
        return bitrate

    duration = probe_duration_seconds(path)
    if duration is None:
        return None

    total_bitrate = int(path.stat().st_size * 8 / duration)
    audio_bitrate = probe_stream_bitrate(path, "a:0") or DEFAULT_AUDIO_BITRATE
    video_bitrate = total_bitrate - audio_bitrate

    return max(video_bitrate, 100_000)


def format_bytes(num_bytes):
    units = ["B", "KiB", "MiB", "GiB"]
    size = float(num_bytes)
    for unit in units:
        if size < 1024 or unit == units[-1]:
            if unit == "B":
                return f"{int(size)} {unit}"
            return f"{size:.1f} {unit}"
        size /= 1024


def size_budget_video_bitrate(max_bytes, duration, audio_bitrate=None):
    if duration is None or duration <= 0 or max_bytes is None:
        return None

    if audio_bitrate is None:
        audio_bitrate = DEFAULT_AUDIO_BITRATE
    budget_bits = int(max_bytes * SIZE_BUDGET_MARGIN * 8)
    video_bitrate = int(budget_bits / duration) - audio_bitrate
    return max(video_bitrate, 100_000)


def quality_rate_args(encoder, quality):
    args = QUALITY_LEVELS[quality].get(encoder, [])
    filtered = []
    skip_next = False

    for arg in args:
        if skip_next:
            skip_next = False
            continue
        if arg == "-preset":
            skip_next = True
            continue
        filtered.append(arg)

    return filtered


def nvidia_encoder_available(encoders):
    if "h264_nvenc" not in encoders:
        return False

    if shutil.which("nvidia-smi") is None:
        return False

    try:
        subprocess.run(
            ["nvidia-smi"],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return False

    return True


def intel_encoder_available(encoders):
    if "h264_qsv" not in encoders:
        return False

    for vendor_path in Path("/sys/class/drm").glob("renderD*/device/vendor"):
        try:
            vendor = vendor_path.read_text().strip().lower()
        except OSError:
            continue

        if vendor != "0x8086":
            continue

        render_node = Path("/dev/dri") / vendor_path.parents[1].name
        if render_node.exists():
            return True

    return False


def detect_video_encoder(no_hw=False):
    if no_hw:
        return ("libx264", None)

    encoders = ffmpeg_encoders()

    if nvidia_encoder_available(encoders):
        return ("h264_nvenc", "NVIDIA NVENC")

    if intel_encoder_available(encoders):
        return ("h264_qsv", "Intel Quick Sync")

    return ("libx264", None)


def print_progress_bar(progress):
    width = 40
    filled = min(width, max(0, round(progress * width)))
    bar = "#" * filled + "-" * (width - filled)
    percent = min(100, max(0, round(progress * 100)))
    print(f"\r[{bar}] {percent:3d}%", end="", flush=True)


def progress_from_file(content, duration):
    out_time_ms = None
    finished = False

    for line in content.splitlines():
        key, _, value = line.partition("=")
        if key == "out_time_ms":
            try:
                out_time_ms = float(value)
            except ValueError:
                continue
        elif key == "progress" and value == "end":
            finished = True

    if finished:
        return 1.0

    if out_time_ms is not None and duration:
        return min(out_time_ms / 1_000_000 / duration, 1.0)

    return None


def run_ffmpeg(command, src):
    duration = probe_duration_seconds(src)
    progress_file = src.parent / f".re-video-progress-{secrets.token_hex(8)}"
    progress_file.unlink(missing_ok=True)

    ffmpeg_command = [
        command[0],
        "-hide_banner",
        "-nostdin",
        "-y",
        "-loglevel",
        "error",
        "-nostats",
        "-progress",
        str(progress_file),
        *command[1:],
    ]

    try:
        process = subprocess.Popen(
            ffmpeg_command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print("ffmpeg is not installed")
        return 1

    last_progress = None
    try:
        while process.poll() is None:
            if progress_file.exists():
                try:
                    content = progress_file.read_text()
                except OSError:
                    content = ""
                progress = progress_from_file(content, duration)
                if progress is not None:
                    rounded = round(progress, 3)
                    if rounded != last_progress:
                        print_progress_bar(progress)
                        last_progress = rounded
            time.sleep(0.1)

        if progress_file.exists():
            try:
                content = progress_file.read_text()
            except OSError:
                content = ""
            progress = progress_from_file(content, duration)
            if progress is not None:
                rounded = round(progress, 3)
                if rounded != last_progress:
                    print_progress_bar(progress)
                    last_progress = rounded
    finally:
        progress_file.unlink(missing_ok=True)

    return_code = process.wait()
    if last_progress is not None:
        print()

    return return_code


def parse_args():
    parser = argparse.ArgumentParser(
        description="Encode videos to mp4 using named ffmpeg profiles."
    )
    parser.add_argument("src", help="Source video file")
    parser.add_argument(
        "--profile",
        choices=sorted(PROFILES),
        default="whatsapp",
        help="Encoding profile to use",
    )
    parser.add_argument(
        "--size",
        type=parse_size,
        help="Resize output using WIDTHxHEIGHT, WIDTHx, or xHEIGHT",
    )
    parser.add_argument(
        "--quality",
        choices=["low", "medium", "high"],
        default="medium",
        help="Output quality level",
    )
    parser.add_argument(
        "--slow",
        action="store_true",
        help=(
            "Spend more time encoding for better quality at a similar file size "
            "(fast probe pass, then two-pass VBR at the measured bitrate)"
        ),
    )
    parser.add_argument(
        "--no-audio",
        action="store_true",
        help="Omit audio from the output file",
    )
    parser.add_argument(
        "--no-hw",
        action="store_true",
        help="Disable hardware acceleration and encode with libx264",
    )
    return parser.parse_args()


def encoding_context(profile_name, size, no_hw=False):
    profile = PROFILES[profile_name]
    encoder, acceleration_name = detect_video_encoder(no_hw=no_hw)
    scale_filter = build_scale_filter(size)
    return profile, encoder, acceleration_name, scale_filter


def build_base_command(src, scale_filter):
    command = ["ffmpeg", "-i", str(src)]

    if scale_filter:
        command.extend(["-vf", scale_filter])

    return command


def append_video_encode_args(
    command, profile, encoder, quality_args, dst=None, no_audio=False
):
    command.extend(["-c:v", encoder])
    command.extend(profile.get("h264_ffmpeg_args", []))
    command.extend(profile.get("encoder_ffmpeg_args", {}).get(encoder, []))
    command.extend(quality_args)
    if no_audio:
        command.append("-an")
    command.extend(profile["ffmpeg_args"])

    if dst is not None:
        command.append(str(dst))

    return command


def build_command(src, dst, profile_name, size, quality, no_audio=False, no_hw=False):
    profile, encoder, acceleration_name, scale_filter = encoding_context(
        profile_name, size, no_hw=no_hw
    )
    command = build_base_command(src, scale_filter)
    append_video_encode_args(
        command,
        profile,
        encoder,
        QUALITY_LEVELS[quality].get(encoder, []),
        dst,
        no_audio=no_audio,
    )

    return command, acceleration_name


def cleanup_passlog_files(logfile):
    for path in logfile.parent.glob(f"{logfile.name}*"):
        path.unlink(missing_ok=True)


def run_quality_encode(
    src, dst, profile, encoder, scale_filter, quality, presets=None, no_audio=False
):
    command = build_base_command(src, scale_filter)
    if presets is None:
        quality_args = QUALITY_LEVELS[quality].get(encoder, [])
    else:
        quality_args = presets + quality_rate_args(encoder, quality)
    append_video_encode_args(
        command, profile, encoder, quality_args, dst, no_audio=no_audio
    )
    return run_ffmpeg(command, src)


def run_bitrate_encode(
    src,
    dst,
    profile,
    encoder,
    scale_filter,
    video_bitrate,
    presets,
    label_prefix="",
    no_audio=False,
):
    bitrate_k = max(video_bitrate // 1000, 100)
    print(f"{label_prefix}Target video bitrate: {bitrate_k}k")

    if encoder == "libx264":
        logfile = src.parent / f"re-video-{secrets.token_hex(8)}"
        try:
            pass1_command = build_base_command(src, scale_filter)
            pass1_args = presets + [
                "-b:v",
                f"{bitrate_k}k",
                "-an",
                "-pass",
                "1",
                "-passlogfile",
                str(logfile),
            ]
            append_video_encode_args(pass1_command, profile, encoder, pass1_args)
            pass1_command.extend(["-f", "null", "-"])

            print(f"{label_prefix}Analysis pass...")
            return_code = run_ffmpeg(pass1_command, src)
            if return_code != 0:
                return return_code

            pass2_command = build_base_command(src, scale_filter)
            pass2_args = presets + [
                "-b:v",
                f"{bitrate_k}k",
                "-pass",
                "2",
                "-passlogfile",
                str(logfile),
            ]
            append_video_encode_args(
                pass2_command,
                profile,
                encoder,
                pass2_args,
                dst,
                no_audio=no_audio,
            )

            print(f"{label_prefix}Final encode...")
            return run_ffmpeg(pass2_command, src)
        finally:
            cleanup_passlog_files(logfile)

    if encoder == "h264_nvenc":
        pass2_command = build_base_command(src, scale_filter)
        pass2_args = presets + [
            "-rc:v",
            "vbr",
            "-b:v",
            f"{bitrate_k}k",
            "-maxrate",
            f"{bitrate_k}k",
        ]
        append_video_encode_args(
            pass2_command,
            profile,
            encoder,
            pass2_args,
            dst,
            no_audio=no_audio,
        )
        print(f"{label_prefix}Final encode (multipass)...")
        return run_ffmpeg(pass2_command, src)

    command = build_base_command(src, scale_filter)
    quality_args = presets + [
        "-b:v",
        f"{bitrate_k}k",
        "-maxrate",
        f"{bitrate_k}k",
    ]
    append_video_encode_args(
        command, profile, encoder, quality_args, dst, no_audio=no_audio
    )
    print(f"{label_prefix}Final encode...")
    return run_ffmpeg(command, src)


def run_slow_encode(
    src,
    dst,
    profile,
    encoder,
    scale_filter,
    quality,
    max_bytes=None,
    no_audio=False,
):
    if max_bytes is not None:
        return run_size_budget_encode(
            src,
            dst,
            profile,
            encoder,
            scale_filter,
            quality,
            max_bytes,
            no_audio=no_audio,
            slow=True,
        )

    if encoder not in TWO_PASS_SLOW_ENCODERS or not profile.get("two_pass", True):
        reason = (
            "two-pass unavailable on QSV"
            if encoder not in TWO_PASS_SLOW_ENCODERS
            else "two-pass disabled by profile"
        )
        print(f"Slow mode: using slower preset ({reason})")
        return run_quality_encode(
            src,
            dst,
            profile,
            encoder,
            scale_filter,
            quality,
            presets=SLOW_FINAL_PRESETS[encoder],
            no_audio=no_audio,
        )

    temp_path = unique_temp_path(src.parent, ".mp4")

    print("Pass 1: measuring bitrate budget...")
    return_code = run_quality_encode(
        src,
        temp_path,
        profile,
        encoder,
        scale_filter,
        quality,
        presets=SLOW_PROBE_PRESETS[encoder],
        no_audio=no_audio,
    )
    if return_code != 0:
        temp_path.unlink(missing_ok=True)
        return return_code

    video_bitrate = probe_video_bitrate(temp_path)
    temp_path.unlink(missing_ok=True)
    if video_bitrate is None:
        print("Could not measure video bitrate from probe pass", file=sys.stderr)
        return 1

    return run_bitrate_encode(
        src,
        dst,
        profile,
        encoder,
        scale_filter,
        video_bitrate,
        SLOW_FINAL_PRESETS[encoder],
        label_prefix="Pass 2: ",
        no_audio=no_audio,
    )


def quality_preset_args(encoder, quality):
    args = QUALITY_LEVELS[quality].get(encoder, [])
    preset = []
    skip_next = False

    for arg in args:
        if skip_next:
            preset.append(arg)
            skip_next = False
            continue
        if arg == "-preset":
            preset.append(arg)
            skip_next = True

    return preset


def bitrate_presets(encoder, quality, slow=False):
    if slow and encoder in SLOW_FINAL_PRESETS:
        return SLOW_FINAL_PRESETS[encoder]

    presets = quality_preset_args(encoder, quality)
    if encoder == "h264_nvenc":
        if not presets:
            presets = ["-preset", "p4"]
        if "-multipass" not in presets:
            presets = [*presets, "-multipass", "fullres"]
        return presets

    return presets or ["-preset", "medium"]


def run_size_budget_encode(
    src,
    dst,
    profile,
    encoder,
    scale_filter,
    quality,
    max_bytes,
    no_audio=False,
    slow=False,
):
    duration = probe_duration_seconds(src)
    audio_bitrate = 0 if no_audio else DEFAULT_AUDIO_BITRATE
    video_bitrate = size_budget_video_bitrate(max_bytes, duration, audio_bitrate)
    if video_bitrate is None:
        print(
            "Could not determine duration for size budget",
            file=sys.stderr,
        )
        return 1

    print(
        f"Targeting ~{format_bytes(int(max_bytes * SIZE_BUDGET_MARGIN))} "
        f"({format_bytes(max_bytes)} limit, {duration:.1f}s)"
    )

    return_code = run_bitrate_encode(
        src,
        dst,
        profile,
        encoder,
        scale_filter,
        video_bitrate,
        bitrate_presets(encoder, quality, slow=slow),
        label_prefix="Size-budget encode: ",
        no_audio=no_audio,
    )
    if return_code != 0:
        return return_code

    if dst.exists():
        final_size = dst.stat().st_size
        print(f"Output size {format_bytes(final_size)}")
        if final_size > max_bytes:
            print(
                f"Warning: output exceeds {format_bytes(max_bytes)} limit",
                file=sys.stderr,
            )

    return 0


def main():
    args = parse_args()
    src = Path(args.src)

    if not src.is_file():
        print("Source file does not exist")
        return 1

    profile = PROFILES[args.profile]
    size = args.size
    if size is None and profile["default_size"]:
        size = parse_size(profile["default_size"])

    dst = unique_output_path(default_output_path(src))
    max_bytes = profile.get("max_bytes")
    no_audio = args.no_audio

    print(f"Encoding to {dst}")
    print(f"Quality: {args.quality}")
    if no_audio:
        print("Audio: disabled")
    if max_bytes is not None:
        print(f"Size limit: {format_bytes(max_bytes)}")
    if args.slow:
        print("Slow mode: enabled")
    if args.no_hw:
        print("Hardware acceleration: disabled")

    profile_cfg, encoder, acceleration_name, scale_filter = encoding_context(
        args.profile, size, no_hw=args.no_hw
    )
    if acceleration_name:
        print(f"Using {acceleration_name} acceleration")

    if args.slow:
        return_code = run_slow_encode(
            src,
            dst,
            profile_cfg,
            encoder,
            scale_filter,
            args.quality,
            max_bytes=max_bytes,
            no_audio=no_audio,
        )
    elif max_bytes is not None:
        return_code = run_size_budget_encode(
            src,
            dst,
            profile_cfg,
            encoder,
            scale_filter,
            args.quality,
            max_bytes,
            no_audio=no_audio,
        )
    else:
        command, _ = build_command(
            src,
            dst,
            args.profile,
            size,
            args.quality,
            no_audio=no_audio,
            no_hw=args.no_hw,
        )
        return_code = run_ffmpeg(command, src)

    if return_code == 0:
        print(f"Output: {dst}")

    return return_code


if __name__ == "__main__":
    raise SystemExit(main())
