#!/usr/bin/env python3

# Launch or bind machine-local browser profiles under ~/.config/browser/.
# See docs/browser.md.

from __future__ import annotations

import os
import sys
from pathlib import Path

HOME = Path.home()
BROWSER_DIR = HOME / ".config/browser"
PROFILES_DIR = BROWSER_DIR / "profiles"
SLOTS = ("default", "private")


def die(msg: str) -> int:
    print(msg, file=sys.stderr)
    return 1


def usage() -> int:
    return die(
        "usage:\n"
        "  browser-profile                     # list profiles\n"
        "  browser-profile set SLOT NAME       # bind slot → profiles/NAME\n"
        "  browser-profile SLOT [args…]        # launch slot (default|private)\n"
        "  browser-profile NAME [args…]        # launch profiles/NAME\n"
        "\n"
        f"SLOTS: {', '.join(SLOTS)}"
    )


def list_profiles() -> list[str]:
    if not PROFILES_DIR.is_dir():
        return []
    names = []
    for path in sorted(PROFILES_DIR.iterdir()):
        if path.name.startswith("."):
            continue
        if path.is_file() or path.is_symlink():
            names.append(path.name)
    return names


def slot_target(slot: str) -> str | None:
    link = BROWSER_DIR / slot
    if not link.is_symlink():
        return None
    return Path(os.readlink(link)).name


def print_profiles() -> int:
    if not PROFILES_DIR.is_dir():
        return die(
            f"{PROFILES_DIR} does not exist.\n"
            "Create executable launchers there, then:\n"
            "  browser-profile set default NAME\n"
            "  browser-profile set private NAME\n"
            "See docs/browser.md."
        )

    bound = {slot: slot_target(slot) for slot in SLOTS}
    for name in list_profiles():
        tags = [slot for slot, target in bound.items() if target == name]
        if tags:
            print(f"{name}  [{', '.join(tags)}]")
        else:
            print(name)
    return 0


def force_symlink(target: str, link: Path) -> None:
    link.parent.mkdir(parents=True, exist_ok=True)
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(target)


def launch(path: Path, args: list[str]) -> int:
    if not path.exists():
        return die(f"{path} does not exist")
    if not os.access(path, os.X_OK):
        return die(f"{path} is not executable")
    os.execv(str(path), [str(path), *args])
    return 1


def bind_slot(slot: str, name: str) -> int:
    if slot not in SLOTS:
        return die(f"unknown slot {slot!r}; expected one of: {', '.join(SLOTS)}")
    if "/" in name or name.startswith("-") or name in ("set", *SLOTS):
        return die(f"invalid profile name {name!r}")
    path = PROFILES_DIR / name
    if not path.exists():
        return die(
            f"profile {name!r} does not exist at {path}.\n"
            f"Create it, then: browser-profile set {slot} {name}"
        )
    force_symlink(f"profiles/{name}", BROWSER_DIR / slot)
    return 0


def run_slot(slot: str, args: list[str]) -> int:
    link = BROWSER_DIR / slot
    if not link.is_symlink() and not link.exists():
        return die(
            f"{link} is not set.\n"
            f"Bind a profile with: browser-profile set {slot} NAME"
        )
    return launch(link, args)


def maybe_hint_old_bind(slot: str, args: list[str]) -> None:
    """Nudge if someone uses the old bind syntax (slot + bare profile name)."""
    if len(args) != 1:
        return
    name = args[0]
    if "/" in name or ":" in name or name.startswith("-") or "." in name:
        return
    if (PROFILES_DIR / name).exists():
        print(
            f"note: launching {slot} with argument {name!r}.\n"
            f"      to bind the slot: browser-profile set {slot} {name}",
            file=sys.stderr,
        )


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return print_profiles()

    first = args[0]
    rest = args[1:]

    if first in ("-h", "--help", "help"):
        return usage()

    if first == "set":
        if len(rest) != 2:
            return die("usage: browser-profile set SLOT NAME")
        return bind_slot(rest[0], rest[1])

    if first in SLOTS:
        maybe_hint_old_bind(first, rest)
        return run_slot(first, rest)

    return launch(PROFILES_DIR / first, rest)


if __name__ == "__main__":
    raise SystemExit(main())
