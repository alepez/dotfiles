#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage:
  fix-file-timestamp --show-delta FILE [DATETIME]
  fix-file-timestamp --apply-delta SECONDS [--dry-run] FILE [FILE...]

  --show-delta  Explain delta seconds needed to set file mtime to DATETIME (defaults to now)
  --apply-delta Add SECONDS to each file's mtime (sets atime/mtime)
  --dry-run     With --apply-delta: print new datetime, do not change files

DATETIME is any format accepted by date(1), e.g. 2026-08-11T09:44:11
Uses mtime (survives copy from SD; birth is usually "now" after import).
EOF
  exit 1
}

file_mtime_epoch() {
  stat -c '%Y' -- "$1"
}

show_delta() {
  local file=$1
  local datetime=${2-}
  local ref_epoch mtime_epoch delta target

  [[ -e "$file" ]] || { echo "error: not found: $file" >&2; exit 1; }

  if [[ -n "$datetime" ]]; then
    ref_epoch=$(date -d "$datetime" +%s) || {
      echo "error: invalid datetime: $datetime" >&2
      exit 1
    }
  else
    ref_epoch=$(date +%s)
  fi
  target=$(date -d "@${ref_epoch}" '+%Y-%m-%dT%H:%M:%S')
  mtime_epoch=$(file_mtime_epoch "$file")
  delta=$((ref_epoch - mtime_epoch))
  echo "You need to apply a delta of ${delta} seconds to set the file creation time to ${target}"
}

apply_delta() {
  local dry_run=$1
  local delta=$2
  shift 2
  local file mtime_epoch new_epoch

  [[ "$delta" =~ ^-?[0-9]+$ ]] || {
    echo "error: delta must be an integer number of seconds: $delta" >&2
    exit 1
  }

  for file in "$@"; do
    [[ -e "$file" ]] || { echo "error: not found: $file" >&2; exit 1; }
    mtime_epoch=$(file_mtime_epoch "$file")
    new_epoch=$((mtime_epoch + delta))
    if [[ "$dry_run" -eq 1 ]]; then
      printf '%s\t%s\n' "$(date -d "@${new_epoch}" '+%Y-%m-%dT%H:%M:%S')" "$file"
    else
      touch -d "@${new_epoch}" -- "$file"
    fi
  done
}

main() {
  local mode= dry_run=0 delta=
  local -a args=()

  [[ $# -ge 1 ]] || usage

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --show-delta)
        [[ -z "$mode" ]] || usage
        mode=show-delta
        shift
        ;;
      --apply-delta)
        [[ -z "$mode" ]] || usage
        mode=apply-delta
        shift
        [[ $# -ge 1 ]] || usage
        delta=$1
        shift
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      -h | --help)
        usage
        ;;
      --)
        shift
        args+=("$@")
        break
        ;;
      -*)
        echo "error: unknown option: $1" >&2
        usage
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  case "$mode" in
    show-delta)
      [[ "$dry_run" -eq 0 && ${#args[@]} -ge 1 && ${#args[@]} -le 2 ]] || usage
      show_delta "${args[@]}"
      ;;
    apply-delta)
      [[ ${#args[@]} -ge 1 ]] || usage
      apply_delta "$dry_run" "$delta" "${args[@]}"
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
