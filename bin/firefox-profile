#!/usr/bin/env bash

# Link firefox-<name> to this file to launch that Firefox profile.
# Example: ln -s ~/.dotfiles/bin/firefox-profile ~/.local/bin/firefox-personal

name="$(basename "$0")"
profile_name="${name#*-}"

if [ -z "${profile_name}" ] || [ "${name}" = "firefox-profile" ]; then
  echo "invoke as firefox-<name> (symlink to this script)" >&2
  exit 1
fi

exec firefox -p "${profile_name}" "$@"
