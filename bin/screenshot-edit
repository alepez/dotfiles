#!/usr/bin/env bash

# Takes a region screenshot with grim/slurp, edits with swappy, then archives
# PNGs/JPGs in DIR older than one day via mv-to-date-dir into
# ARCHIVE/YYYY/YYYY-MM/YYYY-MM-DD (by file mtime).

DIR="${HOME}/Pictures/Screenshots"
ARCHIVE="${HOME}/Pictures/Screenshots/archive"
MV_TO_DATE_DIR="${HOME}/.local/bin/mv-to-date-dir"

archive_old_screenshots() {
  local files=()
  while IFS= read -r f; do
    [[ -n "${f}" ]] && files+=("${f}")
  done < <(find "${DIR}" -maxdepth 1 \( -name '*.png' -o -name '*.jpg' \) -mtime +1)

  ((${#files[@]})) || return 0

  "${MV_TO_DATE_DIR}" --dst-root "${ARCHIVE}" "${files[@]}"
}

main() {
  which grim &>/dev/null || notify-send "grim not found"
  which slurp &>/dev/null || notify-send "slurp not found"
  which swappy &>/dev/null || notify-send "swappy not found"

  local now=$( date +%Y-%m-%dT%H-%M-%S --utc | tr -d \\n )
  grim -g "$(slurp)" - | swappy -f - -o "${DIR}/${now}.png"

  archive_old_screenshots
}

main
